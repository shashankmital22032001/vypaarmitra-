# Copy to .env and fill in. Only VITE_* variables reach the browser: never put secrets here.

# 10-digit WhatsApp number WITHOUT +91 (used for every WhatsApp button and the Call link)
VITE_WHATSAPP_NUMBER=

# API base URL. Leave empty when the backend serves the site (same origin) or in dev (Vite proxy).
VITE_API_URL=
