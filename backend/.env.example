# Copy this file to .env and fill in the values.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vypaarmitra?retryWrites=true&w=majority

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Secret key for reading leads: send it as the "x-api-key" header to GET /api/leads
ADMIN_API_KEY=change-me-to-a-long-random-string

# Website chatbot. With a key, "Mitra" answers with Claude AI; without it, it answers
# common questions from the FAQ. Create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Email alert for every new audit request.
# GoDaddy Professional Email (default, vypaarmitra.com's MX is secureserver.net):
#   host smtpout.secureserver.net, port 465 (SSL). SMTP_USER is the full mailbox address
#   (e.g. you@vypaarmitra.com) and SMTP_PASS is that mailbox's normal password,
#   in double quotes if it contains # or spaces.
# LEAD_NOTIFY_TO is where alerts go (can be the same mailbox, or several addresses separated by commas).
# Leave SMTP_USER / SMTP_PASS empty to turn alerts off.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_TO=
